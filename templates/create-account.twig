{# templates/create-account.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Formulario para crear una cuenta en PAWPrints">
    <meta name="keywords" content="Registro, Crear cuenta, PAWPrints, Libros">
    <title>Crear Cuenta - PAWPrints</title>
    <link rel="stylesheet" href="./css/create-acount.css">
    <script src="./js/pages/accountMenu.js"></script>
    <script src="./js/components/helper.js"></script>
</head>
<body itemscope itemtype="https://schema.org/WebPage">
    {% include 'parts/header.twig' with {
        'loggedUser': loggedUser,
        'username': username,
        'menu_nav': menu_nav
    } %}

    <main itemscope itemtype="https://schema.org/SignUpPage">
        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="./">Home</a></li>
                <li><a href="./">Mi cuenta</a></li>
                <li><a href="./login">Iniciar sesión</a></li>
                <li>Crear cuenta</li>
            </ul>
        </nav>
        
        <section class="container register-container" itemscope itemtype="https://schema.org/Person">
            <h1 itemprop="name">Crear cuenta</h1>

            {% if errors is defined and errors is not empty %}
                <section class="error-messages">
                    {% for error in errors %}
                        <p class="error-text">{{ error | e }}</p>
                    {% endfor %}
                </section>
            {% endif %}

            {% if success is defined and success is not empty %}
                <section class="success-messages">
                    <p class="success-text">{{ success | e }}</p>
                </section>
            {% endif %}

            <form action="/register" method="post" itemprop="potentialAction" itemscope itemtype="https://schema.org/RegisterAction">
                <div class="form-section">
                    <label for="full_name">Nombre y apellido</label>
                    <input
                        type="text"
                        id="full_name"
                        name="full_name"
                        placeholder="ej: Cosme Fulanito"
                        required
                        itemprop="name"
                        value="{{ old.full_name|default('')|e }}"
                    >
                </div>

                <div class="form-section">
                    <label for="email">Email</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="ej: email@gmail.com"
                        required
                        itemprop="email"
                        value="{{ old.email|default('')|e }}"
                    >
                </div>

                {% if loggedUser is defined and loggedUser.role == 'admin' %}
                    <fieldset itemscope itemtype="https://schema.org/Action">
                        <legend>Roles</legend>
                        <label class="role-label">
                            Empleado
                            <input type="radio" name="role" value="empleado" required itemprop="role">
                            <span class="custom-radio"></span>
                        </label>
                        <label class="role-label">
                            Cliente
                            <input type="radio" name="role" value="cliente" required itemprop="role">
                            <span class="custom-radio"></span>
                        </label>
                    </fieldset>
                {% endif %}

                <div class="input-wrapper">
                    <label for="password">Contraseña</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="ej: contraseña123"
                        required
                        itemprop="password"
                    >
                    <button type="button" class="toggle-password" aria-label="Mostrar contraseña" data-target="password">
                        <img src="../icons/close-eye.png" alt="Mostrar contraseña" class="icon-forms">
                    </button>
                </div>

                <div class="input-wrapper">
                    <label for="confirm_password">Confirmar contraseña</label>
                    <input
                        type="password"
                        id="confirm_password"
                        name="confirm_password"
                        placeholder="ej: contraseña123"
                        required
                        itemprop="password"
                    >
                    <button type="button" class="toggle-password" aria-label="Mostrar contraseña" data-target="confirm_password">
                        <img src="../icons/close-eye.png" alt="Mostrar contraseña" class="icon-forms">
                    </button>
                </div>
                
                <button type="submit" itemprop="actionStatus" itemscope itemtype="https://schema.org/FollowAction">Crear cuenta</button>
            </form>
            <p>¿Ya tenés una cuenta? <a href="/login" itemprop="url">Iniciar sesión</a></p>
        </section>
    </main>

    {% include 'parts/footer.twig' %}
 
</body>
</html>
