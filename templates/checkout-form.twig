{# templates/checkout-form.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Formulario de compra en PAWPrints. Ingresa tus datos para completar la compra de tus productos.">
    <meta name="keywords" content="PAWPrints, compra, libros, checkout, formulario">
    <meta name="author" content="PAWPrints">
    <title>Finalizar Compra - PAWPrints</title>
    <link rel="stylesheet" href="./css/checkout-form.css">
</head>
<body>
    {% include 'parts/header.twig' with {
        'loggedUser': loggedUser,
        'username': username,
        'menu_nav': menu_nav
    } %}

    <main>
        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="./">Home</a></li>
                <li><a href="./checkout-form">Finalizar compra</a></li>
            </ul>
        </nav>
        <div class="checkout-container">
            <section class="order-summary">
                <h2>Detalle de tu pedido</h2>
                {% if cart is not empty %}
                    {% set total = 0 %}
                    {% for item in cart %}
                        {# Calculamos subtotal directamente sin filtros float/int #}
                        {% set subtotal = item.precio * item.cantidad %}
                        <article class="order-summary-item">
                            <figure>
                                <a href="/book?id={{ item.id | e }}">
                                    <img src="{{ item.imagen | e }}" alt="Portada de {{ item.titulo | e }}">
                                </a>
                            </figure>
                            <div>
                                <h3>
                                    <a href="/book?id={{ item.id | e }}">{{ item.titulo | e }}</a>
                                </h3>
                                <div class="order-summary-details">
                                    <p>Cantidad: {{ item.cantidad }}</p>
                                    <p>Formato: {{ item.formato | e }}</p>

                                    {% if stockErrors is defined and stockErrors[item.id] is defined %}
                                        <p class="stock-error">
                                            {{ stockErrors[item.id] | e }}
                                        </p>
                                    {% endif %}
                                </div>
                                <div class="order-summary-price">
                                    <p>$ {{ item.precio|number_format(2, ',', '.') }}</p>
                                </div>
                            </div>
                        </article>
                        {# Acumulamos en total #}
                        {% set total = total + subtotal %}
                    {% endfor %}
                    <p class="total">Total: $ {{ total|number_format(2, ',', '.') }}</p>
                {% else %}
                    <p>No hay productos en tu carrito.</p>
                {% endif %}
            </section>

            <!-- Resto del formulario de checkout -->
            <section class="checkout-form">
                <h2>Formulario de compra</h2>

                {% if errors is defined and errors is not empty %}
                    <ul class="errors">
                        {% for error in errors %}
                            <li>{{ error | e }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <form action="/checkout-form" method="POST" novalidate>
                    <div class="form-section">
                        <label for="nombre">Nombre y apellido</label>
                        <input
                            type="text"
                            id="nombre"
                            name="nombre"
                            value="{{ data.nombre|default('') | e }}"
                            placeholder="Cosme Fulanito"
                            required
                        >
                    </div>

                    <div class="form-section">
                        <label for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="{{ data.email|default('') | e }}"
                            placeholder="email@gmail.com"
                            required
                        >
                    </div>

                    <div class="form-section">
                        <label for="telefono">Teléfono</label>
                        <input
                            type="tel"
                            id="telefono"
                            name="telefono"
                            value="{{ data.telefono|default('') | e }}"
                            placeholder="+54 xxxxxxxxxx"
                        >
                    </div>

                    <fieldset class="form-section">
                        <legend>Tipo de entrega</legend>
                        <label>
                            <input
                                type="radio"
                                name="entrega"
                                value="domicilio"
                                {% if data.entrega is not defined or data.entrega == 'domicilio' %}
                                    checked
                                {% endif %}
                            > Entrega a domicilio
                        </label>
                        <label>
                            <input
                                type="radio"
                                name="entrega"
                                value="sucursal"
                                {% if data.entrega is defined and data.entrega == 'sucursal' %}
                                    checked
                                {% endif %}
                            > Retiro en sucursal
                        </label>
                    </fieldset>

                    <div class="form-actions">
                        <button type="submit">Realizar compra</button>
                        <p>¿Ya tenés una cuenta? <a href="/login"><u>Iniciar sesión</u></a></p>
                    </div>
                </form>
            </section>
        </div>
    </main>

    {% include 'parts/footer.twig' %}
</body>
</html>