{# templates/book.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ book.fields.titulo | e }} - Libros en venta en PAWPrints." />
    <meta name="keywords" content="PAWPrints, compra, libros, ebooks, {{ book.fields.titulo | e }}" />
    <meta name="author" content="PAWPrints" />
    <link rel="stylesheet" href="./css/book-information.css" />
    <script src="./js/pages/accountMenu.js"></script>
    <title>{{ book.fields.titulo | e }} | PAWPrints</title>
</head>
<body itemscope itemtype="https://schema.org/WebPage">
    {% include 'parts/header.twig' with {
        'loggedUser': loggedUser,
        'username': username,
        'menu_nav': menu_nav
    } %}

    <main>
        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="./">Home</a></li>
                <li><a href="./books">Libros</a></li>
                <li><span>{{ book.fields.titulo | e }}</span></li>
            </ul>
        </nav>

        <article itemscope itemtype="https://schema.org/Book">
            <h1 itemprop="name">{{ book.fields.titulo | e }}</h1>
            <p>Autor: <span itemprop="author">{{ book.fields.autor | e }}</span></p>
            <p>ISBN: <span itemprop="isbn">{{ book.fields.id | e }}</span></p>
            <p>Editorial: <span itemprop="publisher">{{ book.fields.editorial | e }}</span></p>

            <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                <span itemprop="priceCurrency">ARS</span>
                <span itemprop="price">{{ book.fields.precio | e }}</span>
                <link itemprop="availability" href="https://schema.org/InStock" />
            </div>

            <figure>
                <img src="{{ book.fields.imagen | e }}" alt="Portada de {{ book.fields.titulo | e }}" itemprop="image"/>
            </figure>

            <section itemprop="description">
                <h2>Sinopsis</h2>
                <p>{{ book.fields.descripcion | e }}</p>
            </section>

            <section>
                <h2>Descripción del libro</h2>
                <ul>
                    <li><strong>N° Páginas:</strong> {{ book.fields.paginas | default('—') | e }}</li>
                    <li><strong>Idioma:</strong> <span itemprop="inLanguage">{{ book.fields.idioma | default('—') | e }}</span></li>
                    <li><strong>Fecha Publicación:</strong> {{ book.fields.fecha_publicacion | default('—') | e}}</li>
                </ul>
            </section>

            <div class="purchase-actions">
                <fieldset>
                    <legend>Elige el formato:</legend>
                    <label><input type="radio" name="formato-libro" value="f" checked /> Físico</label>
                    <label><input type="radio" name="formato-libro" value="e" /> Electrónico</label>
                </fieldset>
                <input type="number" id="cantidad" name="cantidad" placeholder="1" min="1" value="1" />
                <button type="button" onclick="addToCart('{{ book.fields.id | e }}')">Al carrito</button>
            </div>
        </article>
    </main>

    {% include 'parts/footer.twig' %}
</body>
</html>
