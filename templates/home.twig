{# templates/home.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Página principal de PAWPrints, librería en línea con sugerencias y libros más vendidos.">
    <meta name="author" content="PAWPrints">
    <title>Inicio | PAWPrints</title>
    <link rel="stylesheet" href="./css/index.css">
</head>
<body itemscope itemtype="https://schema.org/WebPage">
    {# Incluir header.twig: pasándole las variables necesarias #}
    {% include 'parts/header.twig' with {
        'loggedUser': loggedUser,
        'username': username,
        'menu_nav': menu_nav
    } %}

    <main>
        <div id="first-banner"></div>

        <section class="carousel-section" itemscope itemtype="https://schema.org/ItemList" itemprop="mainEntity">
            <h2 itemprop="name">Sugerencias</h2>
            <div class="carousel-wrapper">
                <button class="nav prev" aria-label="Anterior suggestions">&#10094;</button>
                <div class="books-carousel" id="books-carousel">
                    {% for book in books %}
                        <article class="book-card" itemscope itemtype="https://schema.org/Book" itemprop="itemListElement">
                            <figure>
                                <a href="/book?id={{ book.id | e }}" itemprop="url">
                                    {% set imagen = (book.imagen is defined and book.imagen|length > 10) ? book.imagen : '/icons/book.png' %}
                                    <img src="{{ imagen | e }}" alt="Portada de {{ book.titulo | e }}" itemprop="image">
                                </a>
                            </figure>
                            <section class="book-card__footer">
                                <h3 itemprop="name">
                                    <a href="/book?id={{ book.id | e }}">{{ book.titulo | e }}</a>
                                </h3>
                                <p itemprop="author">{{ book.autor | e }}</p>
                                <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                    <span itemprop="priceCurrency">ARS</span>
                                    <span itemprop="price">{{ book.precio }}</span>
                                </div>
                                <button type="button">Comprar</button>
                            </section>
                        </article>
                    {% endfor %}
                </div>
                <button class="nav next" aria-label="Siguiente suggestions">&#10095;</button>
            </div>
        </section>

        <div id="second-banner"></div>

        <section class="carousel-section" itemscope itemtype="https://schema.org/ItemList" itemprop="mainEntity">
            <h2 itemprop="name">Los más vendidos</h2>
            <div class="carousel-wrapper">
                <button class="nav prev-best-sales" aria-label="Anterior best-sellers">&#10094;</button>
                <div class="books-carousel-best-sales" id="books-carousel-best-sales">
                    {% for book in books %}
                        <article class="book-card" itemscope itemtype="https://schema.org/Book" itemprop="itemListElement">
                            <figure>
                                <a href="/book?id={{ book.id | e }}" itemprop="url">
                                    {% set imagen = (book.imagen is defined and book.imagen|length > 10) ? book.imagen : '/icons/book.png' %}
                                    <img src="{{ imagen | e }}" alt="Portada de {{ book.titulo | e }}" itemprop="image">
                                </a>
                            </figure>
                            <section class="book-card__footer">
                                <h3 itemprop="name">
                                    <a href="/book?id={{ book.id | e }}">{{ book.titulo | e }}</a>
                                </h3>
                                <p itemprop="author">{{ book.autor | e }}</p>
                                <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                    <span itemprop="priceCurrency">ARS</span>
                                    <span itemprop="price">{{ book.precio }}</span>
                                </div>
                                <button type="button">Comprar</button>
                            </section>
                        </article>
                    {% endfor %}
                </div>
                <button class="nav next-best-sales" aria-label="Siguiente best-sellers">&#10095;</button>
            </div>
        </section>
    </main>

    {% include 'parts/footer.twig' %}

    <script type="module">
        import { Carousel } from "./js/libraries/carousel.js";
        new Carousel("#first-banner", {
            images: "./images.json",
            transition: "zoom",
            autoplay: true,
            interval: 4000,
            imagePath: "./images/"
        });

        new Carousel("#second-banner", {
            images: "./images.json",
            transition: "zoom",
            autoplay: true,
            interval: 4000,
            imagePath: "./images/"
        });
    </script>
    <script src="./js/pages/homeCarousel.js"></script>
    <script src="./js/pages/accountMenu.js"></script>
</body>
</html>
