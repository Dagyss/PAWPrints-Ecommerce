{# templates/create-book.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Formulario para dar de alta un nuevo libro en PAWPrints." />
    <meta name="keywords" content="PAWPrints, nuevo libro, catálogo, gestión" />
    <meta name="author" content="PAWPrints" />
    <script src="./js/components/paw.js"></script>
    <script src="./js/app-loader.js"></script>
    <script src="./js/pages/createBook.js"></script>
    <script src="./js/pages/accountMenu.js"></script>
    <link rel="stylesheet" href="./css/create-book.css">
    <link rel="stylesheet" href="./css/drag-drop.css">
    <title>Nuevo Libro - PAWPrints</title>
</head>
<body itemscope itemtype="https://schema.org/WebPage">
    {% include 'parts/header.twig' with {
        'loggedUser': loggedUser,
        'username': username,
        'menu_nav': menu_nav
    } %}

    <main itemscope itemtype="https://schema.org/CreateAction">
        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="/" itemprop="url">Home</a></li>
                <li><a href="/books" itemprop="url">Libros</a></li>
                <li><span>Libro Nuevo</span></li>
            </ul>
        </nav>

        <h2 itemprop="targetCollection" itemscope itemtype="https://schema.org/Collection">Formulario de Alta</h2>
        <form action="/create-book" method="post" class="form-content" enctype="multipart/form-data" itemprop="actionStatus" itemscope itemtype="https://schema.org/PublishAction">

            <div class="form-section" itemscope itemtype="https://schema.org/Book">
                <label for="titulo">Título</label>
                <input type="text" id="titulo" name="titulo" placeholder="El Gran Gatsby" required itemprop="name">

                <label for="autor">Autor</label>
                <input type="text" id="autor" name="autor" placeholder="F. Scott Fitzgerald" required itemprop="author">

                <label for="editorial">Editorial</label>
                <input type="text" id="editorial" name="editorial" placeholder="Scribner" itemprop="publisher">

                <label for="isbn">ISBN</label>
                <input type="text" id="isbn" name="isbn" placeholder="9780136006176" itemprop="isbn">

                <label for="idioma">Idioma</label>
                <select name="idioma" id="idioma" itemprop="inLanguage">
                    <option value="espanol">Español</option>
                    <option value="frances">Francés</option>
                    <option value="ingles">Inglés</option>
                    <option value="portugues">Portugués</option>
                    <option value="otro">Otro</option>
                </select>

                <label for="fecha_publicacion">Fecha de Publicación</label>
                <input type="date" id="fecha_publicacion" name="fecha_publicacion" itemprop="datePublished">

                <label for="numero_paginas">Número de Páginas</label>
                <input type="number" id="numero_paginas" name="numero_paginas" placeholder="100" itemprop="numberOfPages">

                <label for="formato">Formato</label>
                <select name="formato" id="formato" itemprop="bookFormat" itemscope itemtype="https://schema.org/BookFormatType">
                    <option value="digital">Digital</option>
                    <option value="fisico">Físico</option>
                </select>

                <label for="categoria">Categoría</label>
                <select name="categoria" id="categoria" itemprop="genre">
                    <option value="ciencia ficcion">Ciencia Ficción</option>
                    <option value="misterio">Misterio</option>
                    <option value="romance">Romance</option>
                    <option value="terror">Terror</option>
                </select>

                <label for="precio">Precio</label>
                <input type="number" step="0.01" id="precio" name="precio" placeholder="20.15" required itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                <meta itemprop="priceCurrency" content="ARS">
                <meta itemprop="price" content="{{ precio | default('') | e }}">

                <label for="sinopsis">Sinopsis</label>
                <textarea id="sinopsis" name="sinopsis" rows="4" cols="50" itemprop="description"></textarea>

                <label for="portada">Portada</label>
                <input type="file" id="portada" name="portada" accept=".jpeg, .jpg, .png" hidden itemprop="image">
                <div class="container-portada">
                    <div class="drop-area">
                        <p>Cargue una imagen de la portada aquí</p>
                    </div>
                    <div class="output-area"></div>
                </div>

            </div>

            <button type="submit" class="accept-button" itemprop="result">Aceptar</button>
        </form>
    </main>

    {% include 'parts/footer.twig' %}
</body>
</html>
